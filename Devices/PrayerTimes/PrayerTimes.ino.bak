void connectWiFi() {
  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);

  display.clearDisplay();
  display.setCursor(0, 0);
  display.print("Connecting");
  display.display();

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
}

void setupTime() {
  configTime(TZ_INFO, "pool.ntp.org", "time.nist.gov");

  display.clearDisplay();
  display.setCursor(0, 0);
  display.print("Sync time...");
  display.display();

  time_t now = time(nullptr);
  while (now < 100000) {
    delay(500);
    now = time(nullptr);
  }
}
bool ButtonState = HIGH;
void checkStopButton() {
  static bool lastButtonState = HIGH;
  static unsigned long lastDebounceTime = 0;

  bool reading = digitalRead(STOP_BUTTON_PIN);

  if (reading != lastButtonState) {
    Serial.println("Debounce");
    lastDebounceTime = millis();
    lastButtonState = reading;
  }

  if ((millis() - lastDebounceTime) > 100) {
    if (reading == LOW && ButtonState == HIGH) {
      ButtonState = LOW;
      Serial.println("pressed");
      if(prayerScreenActive == true)
      {
        stopPrayerSound();
      }
      else
      {
        soundVolume += 5;
        if(soundVolume>30) 
        {
          soundVolume = 5;
        }
        myDFPlayer.volume(soundVolume);
      }
    }
    else if(reading == HIGH && ButtonState == LOW) {
      ButtonState = HIGH;
    }
  }

  lastButtonState = reading;
}

void setup() {
  Serial.begin(115200);

  pinMode(STOP_BUTTON_PIN, INPUT_PULLUP);

  display.begin();
  display.setContrast(55);
  display.clearDisplay();
  display.display();

  FPSerial.begin(9600);
  if (!myDFPlayer.begin(FPSerial)) {  //Use serial to communicate with mp3.
    Serial.println(F("Unable to begin:"));
    Serial.println(F("1.Please recheck the connection!"));
    Serial.println(F("2.Please insert the SD card!"));
  }
  Serial.println(F("DFPlayer Mini online."));
  myDFPlayer.volume(soundVolume);  //Set volume value. From 0 to 30

  connectWiFi();
  setupTime();

  display.clearDisplay();
  display.setCursor(0, 0);
  display.print("Getting times");
  display.display();

  Serial.println("Downloading prayer times...");
  fetchPrayerTimes();

  time_t now = time(nullptr);
  struct tm* t = localtime(&now);
  lastFetchDay = t->tm_mday;
}

void loop() {
  checkStopButton();
  if (WiFi.status() != WL_CONNECTED) {
    connectWiFi();
  }

  checkPrayerTimes();
  dailyUpdateCheck();

  if (prayerScreenActive) {
    drawPrayerScreen();

    if (millis() - prayerScreenStart >= 203000) {
      prayerScreenActive = false;
      activePrayerIndex = -1;
    }
  } else {
    if (millis() - lastDisplayUpdate > 1000) {
      lastDisplayUpdate = millis();
      drawNormalScreen();
    }
  }

  //delay(50);
}